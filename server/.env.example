# ==========================================
# AFFILIATOR KILLER BACKEND CONFIGURATION
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# 1. Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenCode / OpenAI / Groq / Ollama Compatible API
CUSTOM_AI_BASE_URL=https://api.opencode.ai/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=opencode-v1

# 3. Google Sheets Webhook URL (from Google Apps Script Deploy)
SHEETS_WEBHOOK_URL=

# 4. n8n Automation Webhook URL
N8N_WEBHOOK_URL=
N8N_AUTH_TOKEN=

# 5. Shopee Affiliate Parameter
DEFAULT_AFFILIATE_SUB_ID=pinterest_pins

# 6. Teable Database (Optional)
TEABLE_SERVER_URL=https://app.teable.io
TEABLE_API_TOKEN=
TEABLE_TABLE_ID=
