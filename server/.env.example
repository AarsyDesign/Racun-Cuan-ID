# ==========================================
# RACUN CUAN.ID - BACKEND CONFIGURATION
# ==========================================

# Server Port
PORT=3000
NODE_ENV=production

# 1. Official Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_ENVIRONMENT=production

# 2. Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Google Sheets Webhook URL (from Google Apps Script Deploy)
SHEETS_WEBHOOK_URL=

# 4. n8n Automation Webhook URL (Optional)
N8N_WEBHOOK_URL=
N8N_AUTH_TOKEN=

# 5. Shopee Affiliate Parameter
DEFAULT_AFFILIATE_SUB_ID=pinterest_pins
